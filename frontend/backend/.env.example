# Django Settings
SECRET_KEY=django-insecure-healora-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For SQLite (default, auto-configured if DATABASE_URL is empty):
# Leave empty or omit
# For PostgreSQL:
# DATABASE_URL=postgres://db_user:db_password@localhost:5432/healora_db

# JWT settings
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# AI LLM Provider Configuration
# Set your Gemini API key (from Google AI Studio):
GEMINI_API_KEY=
# Or OpenAI API Key (if implementing custom adapters):
# OPENAI_API_KEY=

# Medication reminder SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Scheduler (Redis + Celery)
TIME_ZONE=Asia/Kolkata
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
